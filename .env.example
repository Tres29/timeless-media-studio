# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to GitHub

# Payment Configuration - Paymongo
# Get your API keys from: https://dashboard.paymongo.com/settings/api-keys
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_your_actual_key_here
PAYMONGO_SECRET_KEY=sk_test_your_actual_key_here

# App Configuration
# Use http://localhost:3000 for development
# Use your Vercel domain for production (e.g., https://timeless-media-studio.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Get these from: https://app.supabase.com/project/[your-project]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Email Configuration (Gmail SMTP)
# For Vercel production, this must be set as environment variable
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your_app_specific_password
